{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Rome",
  "branchPrefix": "renovate/",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automergeStrategy": "squash",
  "separateMajorMinor": true,

  "flux": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/",
      "/(^|/)infrastructure/.+\\.ya?ml$/",
      "/(^|/)clusters/.+\\.ya?ml$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images with repository + tag on separate lines in HelmRelease values",
      "managerFilePatterns": [
        "/(^|/)apps/.*helm-release\\.ya?ml$/",
        "/(^|/)infrastructure/.*helm-release\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<depName>[^'\"\\s]+)['\"]?\\s*\\n(?:[^\\n]*\\n){0,3}?\\s*tag:\\s*['\"]?(?<currentValue>[^'\"\\s@]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Docker images in Helm chart values.yaml files (charts/*/values.yaml)",
      "managerFilePatterns": [
        "/(^|/).*charts/.*/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<depName>[^'\"\\s]+)['\"]?\\s*\\n(?:[^\\n]*\\n){0,5}?\\s*tag:\\s*['\"]?(?<currentValue>v?[^'\"\\s@]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{depName}}}"
    }
  ],

  "packageRules": [
    {
      "description": "Global: group minor+patch Helm updates per chart, automerge after 3 days",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "helm {{depName}}",
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "labels": ["automerge", "helm"]
    },
    {
      "description": "Global: major Helm updates require review",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["needs-review", "helm"]
    },
    {
      "description": "Docker: minor+patch automerge after 3 days",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "labels": ["automerge", "docker"]
    },
    {
      "description": "Docker: major requires review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["needs-review", "docker"]
    },
    {
      "description": "Critical infrastructure: always manual review (Authentik, CNPG, Flux, Traefik)",
      "matchPackageNames": [
        "authentik",
        "ghcr.io/goauthentik/server",
        "cloudnative-pg",
        "ghcr.io/cloudnative-pg/cloudnative-pg",
        "flux2",
        "flux-operator",
        "fluxcd/flux2",
        "traefik",
        "traefik/traefik"
      ],
      "automerge": false,
      "labels": ["needs-review", "critical"]
    },
    {
      "description": "Stateful apps with migrations: always manual review (Paperless, Immich)",
      "matchPackageNames": [
        "paperless-ngx",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "immich",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "automerge": false,
      "labels": ["needs-review", "stateful"]
    },
    {
      "description": "TeslaMate: chart bundles Grafana, CNPG, Mosquitto - manual review for minor+",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["teslamate"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["needs-review", "helm"]
    },
    {
      "description": "TeslaMate images: manual review for minor+ (Grafana fork pinned)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["teslamate/teslamate", "teslamate/grafana"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["needs-review", "docker"]
    },
    {
      "description": "Ollama: patch automerge, minor manual (model compatibility)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ollama/ollama"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "labels": ["automerge", "docker"]
    },
    {
      "description": "Open WebUI: patch automerge, minor manual (SSO/API breaking changes)",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["open-webui"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "labels": ["automerge", "helm"]
    },
    {
      "description": "GitHub Actions: pin digests and automerge minor/patch",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "labels": ["automerge", "ci"]
    },
    {
      "description": "GitHub Actions: major requires review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["needs-review", "ci"]
    }
  ]
}
